{
 "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
 "packageManager": "pnpm",
 "testRunner": "vitest",
 "vitest": {
  "configFile": "packages/games/sokoban/stryker.vitest.config.ts"
 },
 "coverageAnalysis": "perTest",
 "mutate": [
  "packages/games/sokoban/src/rules.ts"
 ],
 "reporters": [
  "clear-text",
  "progress"
 ],
 "htmlReporter": {
  "fileName": "reports/mutation/index.html"
 },
 "thresholds": {
  "high": 85,
  "low": 70,
  "break": 65
 },
 "tempDirName": ".stryker-tmp-sokoban",
 "plugins": [
  "@stryker-mutator/vitest-runner"
 ],
 "ignorePatterns": [
  "test-results",
  "playwright-report",
  "reports",
  "coverage",
  "dist",
  ".wrangler",
  ".stryker-tmp*",
  "test-results",
  "node_modules/.vite"
 ],
 "concurrency": 4
}