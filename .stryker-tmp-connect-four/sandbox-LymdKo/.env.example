# Copy to .env.production.local (ignored by Git) for a local release build,
# or define as GitHub Actions secret WP_LEGAL for automated deployment.
# Never commit real values.

# Provider name and postal address for the legal notice (Impressum), pipe-separated:
# WP_LEGAL=Name|Street 1|12345 City|Country
WP_LEGAL=
# Optional contact e-mail shown in the legal notice.
WP_LEGAL_EMAIL=
