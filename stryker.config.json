{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts"
  },
  "coverageAnalysis": "perTest",
  "dryRunTimeoutMinutes": 25,
  "mutate": [
    "packages/game-core/src/**/*.ts",
    "packages/persistence/src/**/*.ts",
    "packages/learning-content/src/**/*.ts",
    "packages/localization/src/locales.ts",
    "packages/localization/src/translate.ts",
    "packages/games/*/src/rules.ts",
    "packages/games/*/src/ai.ts",
    "packages/games/relay-command/src/generator.ts",
    "packages/strategy-engine/src/*.ts",
    "!packages/strategy-engine/src/{content,index,types}.ts",
    "packages/life-engine/src/*.ts",
    "packages/life-engine/src/params/check.ts",
    "!packages/life-engine/src/index.ts",
    "packages/games/probability-detective/src/frac.ts",
    "packages/games/probability-detective/src/generate.ts",
    "packages/games/probability-detective/src/traps.ts",
    "!**/*.d.ts",
    "!packages/learning-content/src/builtin/**"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 85,
    "low": 70,
    "break": 65
  },
  "tempDirName": ".stryker-tmp",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "ignorePatterns": [
    "test-results",
    "playwright-report",
    "reports",
    "coverage",
    "dist",
    ".wrangler",
    ".stryker-tmp*"
  ]
}
