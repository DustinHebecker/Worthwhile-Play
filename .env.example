# Copy to .env.production.local (ignored by Git) for a local release build,
# or define these as GitHub Actions secrets for automated deployment.
# Never commit real values.

# Full name of the provider shown in the Impressum / legal notice.
WP_LEGAL_NAME=
# Pipe-separated postal address lines, e.g. "Street 1|12345 City|Country".
WP_LEGAL_ADDRESS=
# Optional contact e-mail shown in the legal notice.
WP_LEGAL_EMAIL=
